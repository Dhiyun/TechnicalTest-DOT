<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">{{kategori.nama}}</h1>
    <div>
        <a href="/admin/kategori/{{kategori.id}}/edit" class="btn btn-warning">Edit</a>
        <form method="post" action="/admin/kategori/{{kategori.id}}/hapus" class="d-inline"
            onsubmit="return confirm('Hapus kategori {{kategori.nama}}?')">
            <button type="submit" class="btn btn-danger">Hapus</button>
        </form>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Nama</dt>
            <dd class="col-sm-9">{{kategori.nama}}</dd>

            <dt class="col-sm-3">Deskripsi</dt>
            <dd class="col-sm-9">
                {{#if kategori.deskripsi}}
                    {{kategori.deskripsi}}
                {{else}}
                    <span class="text-muted">-</span>
                {{/if}}
            </dd>

            <dt class="col-sm-3">Jumlah Buku</dt>
            <dd class="col-sm-9 mb-0">{{kategori.buku.length}}</dd>
        </dl>
    </div>
</div>

<h2 class="h5 mb-3">Daftar Buku Sesuai Kategori</h2>

<div class="card shadow-sm mb-4">
    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th scope="col" class="text-center text-nowrap">No</th>
                    <th scope="col">Judul</th>
                    <th scope="col" class="text-nowrap">Pengarang</th>
                    <th scope="col" class="text-center text-nowrap">Tahun Terbit</th>
                    <th scope="col" class="text-center text-nowrap">Stok</th>
                </tr>
            </thead>
            <tbody>
                {{#each kategori.buku}}
                <tr>
                    <td class="text-center">{{nomor @index}}</td>
                    <td>{{judul}}</a></td>
                    <td class="text-nowrap">{{pengarang}}</td>
                    <td class="text-center">
                        {{#if tahun_terbit}}
                            {{tahun_terbit}}
                        {{else}}
                            <span class="text-muted">-</span>
                        {{/if}}
                    </td>
                    <td class="text-center">{{stok}}</td>
                </tr>
                {{else}}
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">Belum ada buku di kategori ini</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>

<div>
    <a href="/admin/kategori" class="btn btn-secondary">Kembali</a>
</div>
