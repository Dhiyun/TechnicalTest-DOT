<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">{{kategori.nama}}</h1>
    <div>
        <a href="/admin/kategori/{{kategori.id}}/edit" class="btn btn-warning">Edit</a>
        <form method="post" action="/admin/kategori/{{kategori.id}}/hapus" class="d-inline"
            onsubmit="return confirm('Hapus kategori {{kategori.nama}}?')">
            <button type="submit" class="btn btn-danger">Hapus</button>
        </form>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Nama</dt>
            <dd class="col-sm-9">{{kategori.nama}}</dd>

            <dt class="col-sm-3">Deskripsi</dt>
            <dd class="col-sm-9">
                {{#if kategori.deskripsi}}
                    {{kategori.deskripsi}}
                {{else}}
                    <span class="text-muted">-</span>
                {{/if}}
            </dd>

            <dt class="col-sm-3">Jumlah Buku</dt>
            <dd class="col-sm-9 mb-0">{{kategori.buku.length}}</dd>
        </dl>
    </div>
</div>

<div>
    <a href="/admin/kategori" class="btn btn-secondary">Kembali</a>
</div>
