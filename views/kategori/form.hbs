<h1 class="h3 mb-3">{{title}}</h1>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post" action="{{action}}">
            <div class="mb-3">
                <label for="nama" class="form-label">Nama <span class="text-danger">*</span></label>
                <input type="text" id="nama" name="nama" value="{{kategori.nama}}"
                    class="form-control {{#if errors.nama}}is-invalid{{/if}}">
                {{#if errors.nama}}
                <div class="invalid-feedback">{{errors.nama}}</div>
                {{/if}}
            </div>

            <div class="mb-3">
                <label for="deskripsi" class="form-label">Deskripsi</label>
                <textarea id="deskripsi" name="deskripsi" rows="4"
                    class="form-control {{#if errors.deskripsi}}is-invalid{{/if}}">{{kategori.deskripsi}}</textarea>
                {{#if errors.deskripsi}}
                <div class="invalid-feedback">{{errors.deskripsi}}</div>
                {{/if}}
            </div>

            <a href="/admin/kategori" class="btn btn-secondary">Batal</a>
            <button type="submit" class="btn btn-primary">Simpan</button>
        </form>
    </div>
</div>
