<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">{{title}}</h1>
    <a href="/admin/kategori/tambah" class="btn btn-primary">+ Tambah {{title}}</a>
</div>

{{#if pesan}}
<div class="alert alert-success">{{pesan}}</div>
{{/if}}
{{#if error}}
<div class="alert alert-danger">{{error}}</div>
{{/if}}

<form method="get" action="/admin/kategori" class="d-flex gap-2 mb-3">
    <input type="search" name="search" value="{{search}}" class="form-control" placeholder="Cari nama kategori...">
    <button type="submit" class="btn btn-outline-primary">Cari</button>
    {{#if search}}
        <a href="/admin/kategori" class="btn btn-outline-secondary">Reset</a>
    {{/if}}
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th scope="col" class="text-center text-nowrap">No</th>
                    <th scope="col" class="text-center text-nowrap">Nama</th>
                    <th scope="col" class="text-center text-nowrap">Jumlah Buku</th>
                    <th scope="col" class="text-center text-nowrap">Aksi</th>
                </tr>
            </thead>
            <tbody>
                {{#each kategori}}
                <tr>
                    <td scope="col" class="text-center">{{nomor @index}}</td>
                    <td>{{nama}}</td>
                    <td class="text-center">{{_count.buku}}</td>
                    <td class="text-center text-nowrap">
                        <a href="/admin/kategori/{{id}}" class="btn btn-sm btn-info">Detail</a>
                        <a href="/admin/kategori/{{id}}/edit" class="btn btn-sm btn-warning">Edit</a>
                        <form method="post" action="/admin/kategori/{{id}}/hapus" class="d-inline"
                            onsubmit="return confirm('Hapus kategori {{nama}}?')">
                            <button type="submit" class="btn btn-sm btn-danger">Hapus</button>
                        </form>
                    </td>
                </tr>
                {{else}}
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">
                        {{#if search}}
                            Kategori "{{search}}" tidak ditemukan
                        {{else}}
                            Belum ada kategori
                        {{/if}}
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>
