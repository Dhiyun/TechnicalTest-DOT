<h1 class="h3 mb-3">Buku</h1>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th scope="col" class="text-center text-nowrap">No</th>
                    <th scope="col" class="text-center text-nowrap">Judul</th>
                    <th scope="col" class="text-center">Pengarang</th>
                    <th scope="col" class="text-center text-nowrap">Kategori</th>
                    <th scope="col" class="text-center text-nowrap">Tahun Terbit</th>
                    <th scope="col" class="text-center text-nowrap">Stok</th>
                </tr>
            </thead>
            <tbody>
                {{#each buku}}
                <tr>
                    <td scope="col" class="text-center">{{nomor @index}}</td>
                    <td>{{judul}}</td>
                    <td>{{pengarang}}</td>
                    <td>{{kategori.nama}}</td>
                    <td>
                        {{#if tahun_terbit}}
                            {{tahun_terbit}}
                        {{else}}
                            <span class="text-muted">-</span>
                        {{/if}}
                    </td>
                    <td class="text-center">{{stok}}</td>
                </tr>
                {{else}}
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">Belum ada buku</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>
